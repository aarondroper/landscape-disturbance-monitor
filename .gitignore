# Python environments and caches
.venv/
venv/
node_modules/
.env
.env.*
!.env.example
!.env.production.example
.env*.local
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Build and package metadata
build/
dist/
*.egg-info/
*.whl

# Coverage and test reports
.coverage
.coverage.*
htmlcov/
coverage.xml

# IDE/editor and OS noise
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Reproducible STAC discovery output
data/inventory/*.json

# Local temporary annual acquisition products
data/.tmp/**

# Reproducible EO analytical outputs (keep local build products untracked)
data/derived/**
# Browser-oriented RGB reflectance masters, COGs, quicklooks, and provenance.
data/derived/web-imagery/**
# Coverage and reflectance diagnostic GeoTIFFs, PNGs, and JSON reports are
# local audit artifacts and must never be staged with production source.
data/derived/diagnostics/**
!data/derived/prototype/
!data/derived/prototype/.gitkeep
!data/derived/disturbance/
!data/derived/disturbance/.gitkeep

# Frontend QA captures and temporary raster files
web/qa/
web/screenshots/
*.tmp.tif
*.tmp.tiff
